APP_NAME=GameForge API
APP_ENV=development
DATABASE_URL=sqlite:///./gameforge.db
CORS_ORIGINS=http://localhost:5173

# Primary Generative AI Provider: Google Gemini (Backend only — Never expose to client)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: additional Gemini API keys for round-robin rotation, comma-separated.
# The server spreads requests across GEMINI_API_KEY + every key listed here, and
# automatically rotates to the next key if one comes back rate-limited (HTTP 429)
# or rejected. Leave unset to use a single key.
# GEMINI_API_KEYS=your-second-key-here,your-third-key-here
GEMINI_MODEL=gemma-4-31b-it
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

AI_TIMEOUT_SECONDS=150
AI_MAX_RETRIES=2

# Authentication (Phase B7 — Required for all auth features)
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit your actual secret. This file contains placeholders only.
AUTH_JWT_SECRET=CHANGE_ME_BEFORE_RUNNING_IN_ANY_ENVIRONMENT
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Development Seed (optional — used by scripts/seed_dev.py)
# DEV_SEED_PASSWORD=change-me-for-dev-seed
