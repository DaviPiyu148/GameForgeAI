APP_NAME=GameForge API
APP_ENV=development
DATABASE_URL=sqlite:///./gameforge.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ──────────────────────────────────────────────────────────────────────────────
# PRIMARY GENERATIVE AI PROVIDER: Google Gemini (AI Provider Architecture V2)
# ──────────────────────────────────────────────────────────────────────────────

AI_PROVIDER=gemini

# Configured Gemini API credentials (Backend only — NEVER expose to client/browser).
# Comma-separated list of credentials in GEMINI_API_KEY, or use GEMINI_API_KEYS.
# Sequential failover semantics: Key 1 is always primary while healthy.
# Key 2 is tried only on eligible errors (e.g. 401, 429, 5xx, network timeout).
# First success stops failover. No round-robin or proactive rotation.
# Quota isolation: Each credential should belong to an independent Google API project.
GEMINI_API_KEY=your-primary-gemini-api-key-here
# GEMINI_API_KEYS=your-second-key-here,your-third-key-here

# LEGACY: GEMINI_MODEL is superseded by task-specific model chains below.
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# ──────────────────────────────────────────────────────────────────────────────
# TASK-SPECIFIC MODEL CHAINS (Gemini 3 Family Defaults)
# ──────────────────────────────────────────────────────────────────────────────
# Format: comma-separated ordered list of model IDs to attempt per task type.
# All models in chain must support OpenAI-compatible response_format=json_object.
# GEMINI_GENERATION_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
# GEMINI_REMIX_MODELS=gemini-3.6-flash,gemini-3.7-flash,gemini-3.5-flash
# GEMINI_DSL_PATCH_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_BLUEPRINT_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
# GEMINI_ANALYSIS_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.1-flash-lite
# GEMINI_DIRECTOR_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash

# ──────────────────────────────────────────────────────────────────────────────
# CREDENTIAL HEALTH & DEADLINE SETTINGS
# ──────────────────────────────────────────────────────────────────────────────
KEY_FAILURE_THRESHOLD=3
KEY_COOLDOWN_SECONDS=300
AI_OVERALL_DEADLINE_SECONDS=420

AI_TIMEOUT_SECONDS=150
AI_REPAIR_TIMEOUT_SECONDS=45
AI_REPAIR_MAX_ATTEMPTS=1
AI_MAX_RETRIES=2

# Optional fallback provider: Groq (infrastructure-availability fallback only,
# used when the primary Gemini path is unavailable). Leave GROQ_API_KEY unset
# to disable the fallback entirely.
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional generic OpenAI-compatible provider override (used only if you point
# GameForge at a different hosted model than Gemini/Groq). Leave unset to use
# the Gemini/Groq path above.
# AI_MODEL=gemini-3-flash-preview
# AI_API_KEY=
# AI_BASE_URL=

# Optional: Hugging Face token for higher rate limits / authenticated model
# downloads (sentence-transformers). Not required once the embedding model is
# already cached locally.
# HF_TOKEN=

# Optional: log every SQL statement (verbose — local debugging only)
# DB_ECHO_SQL=false

# Optional: IGDB catalog enrichment (cover art, screenshots, storefront links).
# Discovery works fully without these — enrichment is simply skipped when unset.
# Get credentials at https://api-docs.igdb.com/ (via a Twitch developer app).
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# IGDB_CACHE_TTL_DAYS=7

# Authentication (Phase B7 — Required for all auth features)
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit your actual secret. This file contains placeholders only.
AUTH_JWT_SECRET=CHANGE_ME_BEFORE_RUNNING_IN_ANY_ENVIRONMENT
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Development Seed (optional — used by scripts/seed_dev.py)
# DEV_SEED_PASSWORD=change-me-for-dev-seed
