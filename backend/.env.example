APP_NAME=GameForge API
APP_ENV=development
DATABASE_URL=sqlite:///./gameforge.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Primary Generative AI Provider: Google Gemini (Backend only — Never expose to client)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: additional Gemini API keys for round-robin rotation, comma-separated.
# The server spreads requests across GEMINI_API_KEY + every key listed here, and
# automatically rotates to the next key if one comes back rate-limited (HTTP 429)
# or rejected. Leave unset to use a single key.
# GEMINI_API_KEYS=your-second-key-here,your-third-key-here
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

AI_TIMEOUT_SECONDS=150
AI_MAX_RETRIES=2

# Optional fallback provider: Groq (infrastructure-availability fallback only,
# used when the primary Gemini path is unavailable). Leave GROQ_API_KEY unset
# to disable the fallback entirely.
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional generic OpenAI-compatible provider override (used only if you point
# GameForge at a different hosted model than Gemini/Groq). Leave unset to use
# the Gemini/Groq path above.
# AI_MODEL=gemini-3-flash-preview
# AI_API_KEY=
# AI_BASE_URL=

# Optional: Hugging Face token for higher rate limits / authenticated model
# downloads (sentence-transformers). Not required once the embedding model is
# already cached locally.
# HF_TOKEN=

# Optional: log every SQL statement (verbose — local debugging only)
# DB_ECHO_SQL=false

# Optional: IGDB catalog enrichment (cover art, screenshots, storefront links).
# Discovery works fully without these — enrichment is simply skipped when unset.
# Get credentials at https://api-docs.igdb.com/ (via a Twitch developer app).
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# IGDB_CACHE_TTL_DAYS=7

# Authentication (Phase B7 — Required for all auth features)
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit your actual secret. This file contains placeholders only.
AUTH_JWT_SECRET=CHANGE_ME_BEFORE_RUNNING_IN_ANY_ENVIRONMENT
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Development Seed (optional — used by scripts/seed_dev.py)
# DEV_SEED_PASSWORD=change-me-for-dev-seed
